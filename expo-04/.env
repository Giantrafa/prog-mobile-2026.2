# URL do backend (aos-2026.2/express-01) publicado na Vercel, ex.: https://express-01-xxxx.vercel.app
# Vazia ou inacessível = o app usa o backend falso automaticamente (login: teste@teste.com / 123456)
EXPO_PUBLIC_API_URL=

# true = força o backend falso mesmo com a URL configurada
EXPO_PUBLIC_USE_MOCK_API=false
